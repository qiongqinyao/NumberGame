<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SelectActivity">

    <ImageView
        android:id="@+id/selectBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:src = "@drawable/bg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id = "@+id/selectText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text = "选择数字"
        android:textSize="50sp"
        android:textColor="#ff1210"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="20dp" />

    <!--播放音乐按钮 -->
    <ImageButton
        android:id="@+id/select_music"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:src = "@drawable/btn_music1"
        android:scaleType = "fitCenter"
        android:background="@android:color/transparent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="10dp"
        />

   <com.google.android.material.button.MaterialButton
       android:id="@+id/selectReback"
        android:layout_width="70dp"
        android:layout_height="80dp"
        app:icon="@drawable/back_bg"
        app:iconSize="80dp"
        app:shapeAppearanceOverlay="@style/roundButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="10dp"

        app:backgroundTint="#2196F3"
        app:iconPadding="0dp"
        app:iconGravity="textStart"
        android:padding="0dp"/>

    <ImageButton
        android:id="@+id/Number0"
        android:layout_width="70dp"
        android:layout_height="70dp"

        android:background="@android:color/transparent"
        android:scaleType="fitCenter"
        android:src = "@drawable/on0_24"


        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="115dp"
        />

    <ImageButton
        android:id="@+id/Number2"
        android:layout_width="70dp"
        android:layout_height="70dp"

        android:background="@android:color/transparent"
        android:scaleType="fitCenter"
        android:src = "@drawable/on2_24"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/Number0"
        android:layout_marginTop="115dp"
        />

    <ImageButton
        android:id="@+id/Number5"
        android:layout_width="70dp"
        android:layout_height="70dp"

        android:background="@android:color/transparent"
        android:scaleType="fitCenter"
        android:src = "@drawable/on5_24"


        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/Number2"
        android:layout_marginTop="115dp"
        />

    <ImageButton
        android:id="@+id/Number8"
        android:layout_width="70dp"
        android:layout_height="70dp"

        android:background="@android:color/transparent"
        android:scaleType="fitCenter"
        android:src = "@drawable/on8_24"


        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/Number5"
        android:layout_marginTop="115dp"
        />

    <ImageButton
        android:id="@+id/Number1"
        android:layout_width="70dp"
        android:layout_height="70dp"

        android:background="@android:color/transparent"
        android:scaleType="fitCenter"
        android:src = "@drawable/on1_24"


        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/Number2"
        app:layout_constraintTop_toTopOf="@+id/Number0"
        android:layout_marginTop="115dp"
        android:layout_marginEnd="115dp"
        />

    <ImageButton
        android:id="@+id/Number4"
        android:layout_width="70dp"
        android:layout_height="70dp"

        android:background="@android:color/transparent"
        android:scaleType="fitCenter"
        android:src = "@drawable/on4_24"


        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/Number5"
        app:layout_constraintTop_toTopOf="@+id/Number1"
        android:layout_marginTop="115dp"
        android:layout_marginEnd="115dp"
        />

    <ImageButton
        android:id="@+id/Number7"
        android:layout_width="70dp"
        android:layout_height="70dp"

        android:background="@android:color/transparent"
        android:scaleType="fitCenter"
        android:src = "@drawable/on7_24"


        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/Number8"
        app:layout_constraintTop_toTopOf="@+id/Number4"
        android:layout_marginTop="115dp"
        android:layout_marginEnd="115dp"
        />

    <ImageButton
        android:id="@+id/Number3"
        android:layout_width="70dp"
        android:layout_height="70dp"

        android:background="@android:color/transparent"
        android:scaleType="fitCenter"
        android:src = "@drawable/on3_24"


        app:layout_constraintStart_toStartOf="@+id/Number2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/Number0"
        android:layout_marginTop="115dp"
        android:layout_marginStart="115dp"
        />

    <ImageButton
        android:id="@+id/Number6"
        android:layout_width="70dp"
        android:layout_height="70dp"

        android:background="@android:color/transparent"
        android:scaleType="fitCenter"
        android:src = "@drawable/on6_24"


        app:layout_constraintStart_toStartOf="@+id/Number5"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/Number3"
        android:layout_marginTop="115dp"
        android:layout_marginStart="115dp"
        />

    <ImageButton
        android:id="@+id/Number9"
        android:layout_width="70dp"
        android:layout_height="70dp"

        android:background="@android:color/transparent"
        android:scaleType="fitCenter"
        android:src = "@drawable/on9_24"


        app:layout_constraintStart_toStartOf="@+id/Number8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/Number6"
        android:layout_marginTop="115dp"
        android:layout_marginStart="115dp"
        />



</androidx.constraintlayout.widget.ConstraintLayout>

