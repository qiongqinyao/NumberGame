<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background = "@drawable/main_bg"
    tools:context=".MenuActivity">

    <!--开始按钮 -->

    <ImageButton
        android:id="@+id/menu_start"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:scaleType="fitCenter"
        android:background="@android:color/transparent"
        android:src="@drawable/btnplay_selector"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="170dp"
        />

    <!--播放音乐按钮 -->
    <ImageButton
        android:id="@+id/menu_music"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:src = "@drawable/btn_music1"
        android:scaleType = "fitCenter"
        android:background="@android:color/transparent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/menu_start"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="60dp"
        />

    <!-- 关于按钮-->
    <ImageButton
        android:id="@+id/menu_about"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:src = "@drawable/btn_about1"
        android:scaleType = "fitCenter"
        android:background="@android:color/transparent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/menu_start"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="60dp" />


</androidx.constraintlayout.widget.ConstraintLayout>